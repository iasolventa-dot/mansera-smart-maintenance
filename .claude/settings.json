{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node scripts/hooks/session-start.mjs" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "node scripts/hooks/check-secrets.mjs" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(supabase *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  }
}
