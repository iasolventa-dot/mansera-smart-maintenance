# Copiar a .env.local (local) y configurar los mismos nombres en Vercel / Supabase / Gateway.
# NUNCA subir valores reales. Las credenciales de las apps de MANSERA NO van aquí:
# se guardan cifradas (Supabase Vault) por organización y conexión.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # clave publishable (pública; la protege RLS)
SUPABASE_SERVICE_ROLE_KEY=        # solo servidor; jamás en cliente

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development               # development | staging | production

# --- IA (solo servidor) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=anthropic     # anthropic | openai
AI_MONTHLY_BUDGET_EUR=50
# Asistente de ayuda (ADR-0009). Sin ANTHROPIC_API_KEY funciona en "modo guía" (sin IA).
ASISTENTE_MODELO=claude-opus-5-5     # más barato: claude-haiku-5-5
ASISTENTE_LIMITE_DIARIO=150          # preguntas por usuario y día

# --- Gateway on-prem (firma de trabajos cloud <-> gateway) ---
GATEWAY_SHARED_SECRET=
GATEWAY_POLL_INTERVAL_SEC=30

# --- Webhooks entrantes (verificación de firma) ---
TRELLO_WEBHOOK_SECRET=
SESAME_WEBHOOK_SECRET=

# --- n8n (opcional) ---
N8N_BASE_URL=
N8N_WEBHOOK_TOKEN=

# --- Observabilidad (opcional) ---
SENTRY_DSN=
